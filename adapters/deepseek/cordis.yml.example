[
  {
    "id": "mcp-october-bus",
    "name": "@deepseek-ai/dsh-mcp-client",
    "config": {
      "serverName": "october_bus",
      "transport": "stdio",
      "command": "{{command}}",
      "args": [
        "mcp",
        "stdio",
        "--scope",
        "{{scope}}",
        "--agent",
        "{{agent}}",
        "--name",
        "{{name}}",
        "--data-dir",
        "{{dataDir}}",
        "--runtime-dir",
        "{{runtimeDir}}"
      ]
    }
  }
]
