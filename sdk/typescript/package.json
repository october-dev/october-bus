{
  "name": "@october-dev/october-bus",
  "version": "0.1.0-next.3",
  "description": "TypeScript client for October Bus.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "October",
  "homepage": "https://github.com/october-dev/october-bus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/october-dev/october-bus.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/october-dev/october-bus/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai-agents",
    "agent-communication",
    "coordination",
    "mcp",
    "multi-agent"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "src/*.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:errors",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:errors": "node test/errors.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
