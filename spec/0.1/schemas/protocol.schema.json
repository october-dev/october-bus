{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/october-dev/october-bus/spec/0.1/schemas/protocol.schema.json",
  "title": "October Bus protocol 0.1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["starting", "ready", "working", "idle", "needs_input", "offline"]
    },
    "messageMode": {
      "type": "string",
      "enum": ["notify", "request", "response"]
    },
    "deliveryState": {
      "type": "string",
      "enum": ["queued", "reserved", "delivered", "acknowledged", "expired"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "maxLength": 512 }
      }
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "type": "string", "enum": ["text", "file", "url", "reference"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "text": { "type": "string", "maxLength": 65536 },
        "uri": { "type": "string", "maxLength": 4096 },
        "mediaType": { "type": "string" }
      }
    },
    "createScopeInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protocolVersion", "runtimeVersion", "status", "startedAt"],
      "properties": {
        "name": { "const": "october-bus" },
        "protocolVersion": { "const": "0.1" },
        "runtimeVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "ready" },
        "startedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "createScopeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "scopeToken"],
      "properties": {
        "scopeId": { "$ref": "#/$defs/identifier" },
        "scopeToken": { "type": "string", "minLength": 1 }
      }
    },
    "registerAgentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/capability" }
        },
        "connectTo": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "leaseMs": {
          "anyOf": [
            { "const": 0 },
            { "type": "integer", "minimum": 30000, "maximum": 86400000 }
          ]
        }
      }
    },
    "agentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "agentId", "executionId"],
      "properties": {
        "scopeId": { "$ref": "#/$defs/identifier" },
        "agentId": { "$ref": "#/$defs/identifier" },
        "executionId": { "$ref": "#/$defs/identifier" }
      }
    },
    "registerAgentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "agentId", "executionId", "agentToken", "leaseExpiresAt"],
      "properties": {
        "scopeId": { "$ref": "#/$defs/identifier" },
        "agentId": { "$ref": "#/$defs/identifier" },
        "executionId": { "$ref": "#/$defs/identifier" },
        "agentToken": { "type": "string", "minLength": 1 },
        "leaseExpiresAt": { "$ref": "#/$defs/instant" }
      }
    },
    "heartbeatInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "ready"],
      "properties": {
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "ready": { "type": "boolean" },
        "leaseMs": {
          "anyOf": [
            { "const": 0 },
            { "type": "integer", "minimum": 30000, "maximum": 86400000 }
          ]
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "capabilities", "lifecycle", "ready", "reachable", "executionId", "registeredAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/capability" }
        },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "ready": { "type": "boolean" },
        "reachable": { "type": "boolean" },
        "executionId": { "$ref": "#/$defs/identifier" },
        "registeredAt": { "$ref": "#/$defs/instant" },
        "updatedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "sendMessageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "body"],
      "properties": {
        "to": { "$ref": "#/$defs/identifier" },
        "body": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "mode": { "$ref": "#/$defs/messageMode" },
        "responseTo": { "$ref": "#/$defs/identifier" },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "expiresInMs": { "type": "integer", "minimum": 0, "maximum": 2592000000 },
        "context": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/contextItem" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "response" } }
          },
          "then": { "required": ["responseTo"] },
          "else": { "not": { "required": ["responseTo"] } }
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopeId", "from", "to", "mode", "body", "context", "state", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "mode": { "$ref": "#/$defs/messageMode" },
        "body": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "context": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/contextItem" }
        },
        "responseTo": { "$ref": "#/$defs/identifier" },
        "state": { "$ref": "#/$defs/deliveryState" },
        "createdAt": { "$ref": "#/$defs/instant" },
        "expiresAt": { "$ref": "#/$defs/instant" },
        "deliveredAt": { "$ref": "#/$defs/instant" },
        "acknowledgedAt": { "$ref": "#/$defs/instant" },
        "repliedAt": { "$ref": "#/$defs/instant" },
        "responseMessageId": { "$ref": "#/$defs/identifier" }
      }
    },
    "deliveryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "state", "acceptedAt"],
      "properties": {
        "messageId": { "$ref": "#/$defs/identifier" },
        "state": { "$ref": "#/$defs/deliveryState" },
        "acceptedAt": { "$ref": "#/$defs/instant" },
        "deliveredAt": { "$ref": "#/$defs/instant" },
        "acknowledgedAt": { "$ref": "#/$defs/instant" },
        "repliedAt": { "$ref": "#/$defs/instant" },
        "responseMessageId": { "$ref": "#/$defs/identifier" }
      }
    },
    "reserveInboxInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 0, "maximum": 100 },
        "waitMs": { "type": "integer", "minimum": 0, "maximum": 25000 }
      }
    },
    "inboxReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expiresAt", "messages"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "expiresAt": { "$ref": "#/$defs/instant" },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } }
      }
    },
    "addTaskInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 16384 },
        "dependencies": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "taskProgressKind": {
      "type": "string",
      "enum": ["progress", "note", "blocker"]
    },
    "addTaskProgressInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "$ref": "#/$defs/taskProgressKind" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "taskProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sequence", "agentId", "executionId", "kind", "text", "createdAt"],
      "properties": {
        "taskId": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "agentId": { "$ref": "#/$defs/identifier" },
        "executionId": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/taskProgressKind" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "createdAt": { "$ref": "#/$defs/instant" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopeId", "title", "description", "createdBy", "status", "dependencies", "ready", "recentProgress", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 16384 },
        "createdBy": {
          "anyOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "claimedBy": { "$ref": "#/$defs/identifier" },
        "status": { "type": "string", "enum": ["open", "claimed", "done"] },
        "dependencies": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "ready": { "type": "boolean" },
        "recentProgress": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/taskProgress" }
        },
        "note": { "type": "string", "maxLength": 16384 },
        "createdAt": { "$ref": "#/$defs/instant" },
        "updatedAt": { "$ref": "#/$defs/instant" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "open" } } },
          "then": { "not": { "required": ["claimedBy"] } },
          "else": { "required": ["claimedBy"] }
        }
      ]
    },
    "busEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopeId", "type", "subjectId", "revision", "attributes", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string", "minLength": 1 },
        "subjectId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "createdAt": { "$ref": "#/$defs/instant" }
      }
    },
    "eventBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "events", "nextRevision", "currentRevision", "minimumCursor", "resyncRequired"],
      "properties": {
        "scopeId": { "$ref": "#/$defs/identifier" },
        "events": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/busEvent" }
        },
        "nextRevision": { "type": "integer", "minimum": 0 },
        "currentRevision": { "type": "integer", "minimum": 0 },
        "minimumCursor": { "type": "integer", "minimum": 0 },
        "resyncRequired": { "type": "boolean" }
      }
    },
    "storageRecordSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "state", "count", "estimatedBytes"],
      "properties": {
        "recordType": { "type": "string", "enum": ["message", "task", "taskProgress", "escalation", "event"] },
        "state": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "estimatedBytes": { "type": "integer", "minimum": 0 },
        "oldestAt": { "$ref": "#/$defs/instant" }
      }
    },
    "storageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "generatedAt", "totalEstimatedBytes", "records"],
      "properties": {
        "scopeId": { "$ref": "#/$defs/identifier" },
        "generatedAt": { "$ref": "#/$defs/instant" },
        "totalEstimatedBytes": { "type": "integer", "minimum": 0 },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/storageRecordSummary" }
        }
      }
    },
    "pruneScopeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before"],
      "properties": {
        "before": { "$ref": "#/$defs/instant" },
        "execute": { "type": "boolean" }
      }
    },
    "retentionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "tasks", "taskProgress", "escalations", "events"],
      "properties": {
        "messages": { "type": "integer", "minimum": 0 },
        "tasks": { "type": "integer", "minimum": 0 },
        "taskProgress": { "type": "integer", "minimum": 0 },
        "escalations": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 }
      }
    },
    "pruneScopeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "before", "dryRun", "records"],
      "properties": {
        "scopeId": { "$ref": "#/$defs/identifier" },
        "before": { "$ref": "#/$defs/instant" },
        "dryRun": { "type": "boolean" },
        "records": { "$ref": "#/$defs/retentionCounts" }
      }
    },
    "askHumanInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "anyOf": [
            { "maxItems": 0 },
            { "minItems": 2, "maxItems": 4 }
          ]
        }
      }
    },
    "humanEscalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopeId", "agentId", "question", "options", "status", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "agentId": { "$ref": "#/$defs/identifier" },
        "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "answer": { "type": "string", "maxLength": 16384 },
        "createdAt": { "$ref": "#/$defs/instant" },
        "resolvedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["INVALID_ARGUMENT", "UNAUTHENTICATED", "PERMISSION_DENIED", "NOT_FOUND", "METHOD_NOT_ALLOWED", "CONFLICT", "BACKPRESSURE", "INTERNAL"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
